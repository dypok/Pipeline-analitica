# ==============================================================================
# MEDALLION PLATFORM — VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# ==============================================================================
# Copia este archivo como .env y ajusta los valores según tu entorno local:
#   cp .env.example .env
#
# ADVERTENCIA: Nunca subas el archivo .env real con credenciales a Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración General del Proyecto y Backend
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME=medallion-platform
VERSION=2.0.0
LOG_LEVEL=INFO
DATA_DIR=./data
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. PostgreSQL (Metadatos de Airflow y Almacén Analítico Gold)
# ------------------------------------------------------------------------------
# NOTA: En el host Linux se mapea al puerto 5433 para evitar conflictos con
# instancias locales de PostgreSQL en el 5432.
POSTGRES_USER=medallion_user
POSTGRES_PASSWORD=medallion_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_AIRFLOW_DB=airflow_db
POSTGRES_ANALYTICAL_DB=analytics_db

# URLs de conexión internas para servicios Docker
AIRFLOW_DATABASE_URL=postgresql+psycopg2://medallion_user:medallion_secret@postgres:5432/airflow_db
ANALYTICS_DATABASE_URL=postgresql+psycopg2://medallion_user:medallion_secret@postgres:5432/analytics_db

# URLs de conexión para scripts ejecutados desde el host
HOST_ANALYTICS_DB_URL=postgresql+psycopg2://medallion_user:medallion_secret@localhost:5433/analytics_db

# ------------------------------------------------------------------------------
# 3. MinIO (Almacenamiento de Objetos S3 Compatible)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_REGION=us-east-1
MINIO_SECURE=false

# Endpoints
MINIO_ENDPOINT=http://minio:9000
MINIO_HOST_ENDPOINT=http://localhost:9000

# Buckets de la Arquitectura Medallion
MINIO_BUCKET_LANDING=landing
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold
MINIO_BUCKET_QUARANTINE=quarantine

# ------------------------------------------------------------------------------
# 4. Apache Spark (Motor de Transformación y Procesamiento)
# ------------------------------------------------------------------------------
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8081
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g

# Dependencias Hadoop S3A para conexión con MinIO
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_VERSION=1.12.262

# ------------------------------------------------------------------------------
# 5. Apache Airflow (Orquestación y Coordinación de Pipelines)
# ------------------------------------------------------------------------------
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1-python3.11
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__DEFAULT_TIMEZONE=America/Bogota

# Alertas del DAG maestro (US-10). Si se define AIRFLOW_ALERT_EMAIL se envía correo ante fallos;
# en todos los casos se registra una alerta en los logs del scheduler.
AIRFLOW_ALERT_EMAIL=
MOCK_ORDER_COUNT=200
MOCK_CUSTOMER_COUNT=40

# Usuario Administrador inicial para la UI Web de Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Luis
AIRFLOW_ADMIN_LASTNAME=Gomez
AIRFLOW_ADMIN_EMAIL=admin@medallion.local
# ------------------------------------------------------------------------------
# 5. Ingesta REST API (Héctor, US-05) y Alertas por Correo (US-11)
# ------------------------------------------------------------------------------
USE_REST_API_INGEST=false
REST_API_BASE_URL=
REST_API_ENDPOINT=orders
REST_API_SOURCE_ID=rest_api_sales
REST_API_DATASET_NAME=orders
REST_API_PAGINATION_TYPE=page_number
REST_API_PAGE_SIZE=100
REST_API_MAX_PAGES=50
# Authentication (se leen desde entorno, nunca se guardan en código)
# REST_API_AUTH_TYPE=bearer|api_key
# REST_API_TOKEN_ENV_VAR=SALES_API_TOKEN
# REST_API_API_KEY_HEADER=X-API-Key

# Alertas por correo (US-11 / Observabilidad)
AIRFLOW_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=airflow@medallion.local

# ------------------------------------------------------------------------------
# 6. Capa de Consulta DuckDB y Chatbot con IA (Dylan Gamero, US-12 y US-13)
# ------------------------------------------------------------------------------
GOLD_DATA_PATH=data/mock/gold
MAX_QUERY_ROWS=500
QUERY_TIMEOUT_SECONDS=5

# Proveedor de Inteligencia Artificial (LLM)
# Por defecto utiliza el modelo local Qwen2.5 (2B class) en un servidor local compatible
# con OpenAI (ej. Ollama en http://localhost:11434/v1). No requiere API keys.
LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:1.5b
LOCAL_LLM_TIMEOUT=30.0

# Opcionales si se desea usar un proveedor externo:
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 7. Dashboards Streamlit (Sergio, US-14 y US-15)
# ------------------------------------------------------------------------------
# URL del backend FastAPI que expone el chatbot y los endpoints analíticos.
BACKEND_API_URL=http://localhost:8000
# Puerto donde se sirve la aplicación Streamlit.
STREAMLIT_PORT=8501
# Ruta local a los Parquet de Gold mock (fallback cuando PostgreSQL no está disponible).
DASHBOARDS_GOLD_PATH=./data/mock/gold
