# Entorno de Ejecución
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# MinIO / Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET_GOLD=gold

# Capa de Consulta DuckDB
GOLD_DATA_PATH=data/mock/gold

# Proveedor de Inteligencia Artificial (LLM)
# Opciones: mock, gemini, openai
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash
